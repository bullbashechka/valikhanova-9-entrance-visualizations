  "assumptions": [
    {
      "id": "A01",
      "element": "Размеры",
      "value": "36 измерений этапа 1; исходные координаты без округления. Тамбур 8.668 м² против подписи 8.72: контур не подгоняется."
    },
    {
      "id": "A02",
      "element": "S2-17",
      "value": "По явному подтверждению пользователя дверь второго этажа на +3.300. Прежняя подпись обмера «лестница — улица» отменена для сцены. На первом этаже под дверью стена; верхний приёмный фрагмент за дверью условный, без дизайна второго этажа."
    },
    {
      "id": "A03",
      "element": "Лестница",
      "value": "Два марша по 11 подъёмов 150 мм, промежуточная площадка +1.650; толщина маршей 150 мм, ограждения 1000 мм условно. Плановое пятно и уровень +3.300 сохранены."
    },
    {
      "id": "A04",
      "element": "Высоты",
      "value": "Потолок 3000 мм без опуска; входные двери 2400 мм, остальные 2100 мм условно; два участка остекления: подоконник 900 мм, высота 1500 мм условно."
    },
    {
      "id": "A05",
      "element": "Наружный вход",
      "value": "Отметки −0.010/−1.060; 7 подъёмов по 150 мм, 6 проступей; подъёмник условный, не изделие. Навес 2700 мм, ограждения 1000 мм условно."
    },
    {
      "id": "A06",
      "element": "Коляска",
      "value": "Одна коляска около 1.00 × 0.62 м показывает назначение, не вместимость."
    },
    {
      "id": "A07",
      "element": "Проверки",
      "value": "Проверочный габарит 0.60 × 2.00 м, как в секции 1; не нормативный расчёт и не подтверждение доступности оборудования."
    }
